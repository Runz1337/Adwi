# The site is a prebuilt static export and the wish API is a single dependency-free
# file, so nothing here needs to be installed or built. Keep the upload to just
# those two things plus the config that routes between them. Vercel already
# ignores .git and node_modules.

# workspace libraries and tooling: nothing that ships uses them
lib
scripts
artifacts/mockup-sandbox
artifacts/birthday-site/src
artifacts/birthday-site/dist
artifacts/birthday-site/build.mjs
artifacts/birthday-site/.replit-artifact

# repo-level noise
.cache
.local
.conversation
pnpm-lock.yaml
.replit
.replitignore
replit.md

# dev-only files that ship inside the export
artifacts/birthday-site/public/dev
artifacts/birthday-site/public/README-HOSTING.txt
