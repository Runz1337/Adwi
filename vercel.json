{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "birthday_site": {
      "root": "artifacts/birthday-site",
      "installCommand": "echo 'static export: nothing to install'",
      "buildCommand": "echo 'static export: nothing to build'",
      "outputDirectory": "public"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "birthday_site" } }],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/basis/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mediapipe/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}