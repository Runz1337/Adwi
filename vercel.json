{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "birthday_site": {
      "root": "artifacts/birthday-site",
      "installCommand": "echo 'static export: nothing to install'",
      "buildCommand": "echo 'static export: nothing to build'",
      "outputDirectory": "public"
    },
    "wish_api": {
      "root": "wish-api",
      "installCommand": "",
      "buildCommand": "",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "wish_api" } },
    { "source": "/(.*)", "destination": { "service": "birthday_site" } }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/basis/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/mediapipe/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}